# Canlı demo ayarları. Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerini yaz.
# .env GitHub'a GİTMEZ (.gitignore); bu şablon gider, içinde gerçek şifre olmamalı.

# PostgreSQL: postgresql+psycopg://<kullanıcı>:<şifre>@localhost:5432/<veritabanı>
DATABASE_URL=postgresql+psycopg://ids_demo_user:SIFRENI_BURAYA_YAZ@localhost:5432/ids_demo

# PostgreSQL'siz deneme için (tek dosya, kurulum gerekmez):
# DATABASE_URL=sqlite:///outputs/dnn_edgeiiot/demo/ids_demo.db
